{
  "name": "pi-worktree-preview",
  "version": "0.2.3",
  "description": "Review isolated Git worktree changes in your original checkout from Pi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wloops/pi-worktree-preview.git"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "git",
    "worktree"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test test/*.test.ts"
  }
}
